# Copy to .env and fill in real values there. .env is gitignored; this
# file (.env.example) is committed to git, so never put a real secret in
# it -- only blanks or non-secret defaults.
#
# Bolo-Sarkar reads this via python-dotenv at startup (bolo/config.py).
# Nothing here is read by, or written to, the sibling Whatsapp-Chatbot-Gov
# repo -- that project keeps its own .env.

# --- Service ---
HOST=0.0.0.0
PORT=8080
# Public URL for this service (ngrok/Cloudflare Tunnel during the
# buildathon). Required before you can register an Agora agent, since
# Agora needs to reach /v1/chat/completions over the internet.
PUBLIC_BASE_URL=
# Optional shared secret Agora sends back as llm.api_key on every request.
# Leave blank to skip verification (fine for a demo).
LLM_VERIFICATION_API_KEY=

# --- GovScheme bridge ---
# Path to your Whatsapp-Chatbot-Gov checkout. Defaults to
# ../Whatsapp-Chatbot-Gov relative to this repo if unset.
GOVSCHEME_REPO_PATH=

# --- Agora ---
# See docs/AGORA_SETUP.md for exactly how to get each of these four.
# Short version: `agora project env --shell` (after `agora login` +
# `agora project create --feature rtc --feature convoai`) only gives you
# AGORA_APP_ID -- App Certificate and the Customer ID/Secret pair still
# need a manual step in Agora Console (see the doc).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# Optional: SIP URI Vobiz Dials after Bolo start_agent (Media Gateway).
# Use {channel} placeholder. Leave blank to Dial sip:{channel}@Agora India SBC.
# AGORA_SIP_BRIDGE_URI=sip:{channel}@your-media-gateway.example.com

# ASR vendor. "ares" = Agora-managed, zero extra credentials, confirmed
# hi-IN/en-IN support -- good default. "sarvam" = BYOK, better
# Hindi/English code-switching (needs SARVAM_API_KEY below).
AGORA_ASR_VENDOR=ares
AGORA_ASR_LANGUAGE=hi-IN

# TTS vendor. "sarvam" = BYOK, confirmed Hindi voices (recommended for the
# demo). "minimax" = Agora-managed/free-tier, English-confirmed only.
AGORA_TTS_VENDOR=sarvam
AGORA_TTS_VOICE_ID=
AGORA_GREETING_MESSAGE=

# Sarvam AI credentials (https://dashboard.sarvam.ai) -- only needed if
# AGORA_ASR_VENDOR or AGORA_TTS_VENDOR above is "sarvam".
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=anushka

# --- Vobiz --- see docs/VOBIZ_SETUP.md
# Auth ID looks like "MA_XXXXXXXX", from the Vobiz Console dashboard.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_DID_NUMBER=
# Outbound SIP (Agora campaigns → Vobiz). From Vobiz Outbound Trunks /
# Credentials List. See GET /telephony/sip-setup after the server is up.
VOBIZ_SIP_DOMAIN=
VOBIZ_SIP_USERNAME=
VOBIZ_SIP_PASSWORD=
# Vobiz has no separate SMS product -- case confirmations go out over
# WhatsApp via Vobiz's messaging API, which needs a WhatsApp Business
# Account connected as a channel in Vobiz Console first.
VOBIZ_WHATSAPP_CHANNEL_ID=
VOBIZ_WHATSAPP_WABA_ID=

# --- Local data paths (override only if you want them elsewhere) ---
CASES_STORE_PATH=
ESCALATION_LOG_PATH=
